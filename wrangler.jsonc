{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "chan-resonance-dashboard",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-18",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "MARKET_CACHE_TTL_SECONDS": "300",
    "MARKET_STALE_TTL_SECONDS": "86400",
    "MARKET_REQUEST_TIMEOUT_MS": "9000",
    "MARKET_PROVIDER_CONCURRENCY": "4",
    "TURSO_DATABASE_URL": "libsql://chan-dashboard-lovewater.aws-ap-northeast-1.turso.io",
    "CRON_SCAN_BATCH": "8",
    "CRON_CYCLE_HOUR_UTC": "16",
    "CRON_CN_SYNC_DEADLINE_HOURS": "1",
    "CRON_IGNORE_GATE": "0"
  },
  "triggers": {
    "crons": ["* * * * *"]
  },
  "routes": [
    { "pattern": "pan.020417.xyz", "custom_domain": true }
  ]
}
