{
  "name": "chan-resonance-dashboard",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web \"pnpm dev:api\" \"pnpm dev:web\"",
    "dev:web": "vite",
    "dev:api": "node --watch server/node/index.ts",
    "build": "vue-tsc --noEmit && vite build",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "start": "node server/node/index.ts",
    "cf:build": "pnpm build && wrangler deploy --dry-run --outdir dist-worker",
    "cf:dev": "wrangler dev",
    "cf:deploy": "pnpm build && wrangler deploy",
    "vercel:dev": "vercel dev",
    "vercel:build": "node server/core/vercel-build.ts",
    "docker:up": "docker compose up --build"
  },
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "echarts": "^6.0.0",
    "pg": "^8.23.1",
    "pinia": "^3.0.4",
    "vue": "^3.5.26",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^24.10.9",
    "@types/pg": "^8.23.1",
    "@vercel/build-utils": "^15.4.2",
    "@vercel/node": "^31.0.2",
    "@vitejs/plugin-vue": "^6.0.4",
    "concurrently": "^9.2.1",
    "fs-extra": "^11.4.1",
    "multistream": "^4.1.0",
    "typescript": "~5.9.3",
    "vercel": "^66.1.0",
    "vite": "^7.3.1",
    "vitest": "^4.0.18",
    "vue-tsc": "^3.2.3",
    "wrangler": "^4.59.2"
  },
  "packageManager": "pnpm@9.15.4"
}
